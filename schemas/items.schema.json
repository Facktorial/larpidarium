{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "category": {
      "description": "[[category]]",
      "items": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "description": "Color as #rrggbb.",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "id": {
            "description": "Id of the category: lowercase ASCII letters, digits and dashes.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "id"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "item": {
      "description": "[[item]]: physical things.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "description": "Id of a category from items.toml.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "ending": {
            "description": "Reaching it ends the game (an ending).",
            "type": "boolean"
          },
          "handout": {
            "description": "Text printed on a handout card for players (handouts).",
            "type": "string"
          },
          "id": {
            "description": "Id of the item: lowercase ASCII letters, digits and dashes.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "location": {
            "description": "Id of the room where it lies, or where its prop waits.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "owners": {
            "description": "Ids of people, rooms or factions that have it at the start.",
            "items": {
              "description": "Id of people, rooms or factions that have it at the start.",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            "type": "array"
          },
          "prop": {
            "description": "The physical prop organizers bring (packing list).",
            "type": "string"
          },
          "quantity": {
            "description": "How many props (default 1).",
            "minimum": 1,
            "type": "integer"
          },
          "starting": {
            "description": "Exists when the game starts.",
            "type": "boolean"
          },
          "text": {
            "description": "Description.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [],
  "title": "items.toml",
  "type": "object"
}
