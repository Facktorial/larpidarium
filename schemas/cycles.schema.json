{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "cycle": {
      "description": "[[cycle]]: one hero's journey on the world timeline.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "description": "Color as #rrggbb.",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "from": {
            "description": "Id of the world segment where it starts.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "hero": {
            "description": "Id of the character who goes through it.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "id": {
            "description": "Id of the cycle: lowercase ASCII letters, digits and dashes.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "text": {
            "description": "Notes for organizers.",
            "type": "string"
          },
          "to": {
            "description": "Id of the world segment where it ends (default: from).",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "hero",
          "from"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [],
  "title": "cycles.toml",
  "type": "object"
}
