{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "info": {
      "description": "[[info]]: knowledge and story facts.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "category": {
            "description": "Id of a category from items.toml.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "ending": {
            "description": "Reaching it ends the game (an ending).",
            "type": "boolean"
          },
          "id": {
            "description": "Id of the info: lowercase ASCII letters, digits and dashes.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "owners": {
            "description": "Ids of people, rooms or factions that have it at the start.",
            "items": {
              "description": "Id of people, rooms or factions that have it at the start.",
              "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
              "type": "string"
            },
            "type": "array"
          },
          "starting": {
            "description": "Exists when the game starts.",
            "type": "boolean"
          },
          "text": {
            "description": "Description.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [],
  "title": "info.toml",
  "type": "object"
}
