{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "faction": {
      "description": "[[faction]]: groups of people; members write `factions = [...]`.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "description": "Color as #rrggbb.",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "goals": {
            "description": "Goals every member shares (on their sheets).",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "description": "Id of the faction: lowercase ASCII letters, digits and dashes.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "secrets": {
            "description": "Secrets every member knows.",
            "items": {
              "type": "string"
            },
            "type": "array"
          },
          "sheet": {
            "additionalProperties": {
              "type": "string"
            },
            "description": "More sections on every member's sheet.",
            "type": "object"
          },
          "status": {
            "description": "How far the writing is; shown in the progress panel.",
            "enum": [
              "draft",
              "review",
              "done"
            ]
          },
          "text": {
            "description": "Notes for organizers.",
            "type": "string"
          },
          "writer": {
            "description": "Who writes it.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [],
  "title": "factions.toml",
  "type": "object"
}
