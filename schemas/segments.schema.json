{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "additionalProperties": false,
  "properties": {
    "segment": {
      "description": "[[segment]]: world time, in order.",
      "items": {
        "additionalProperties": false,
        "properties": {
          "color": {
            "description": "Color as #rrggbb.",
            "pattern": "^#[0-9a-fA-F]{6}$",
            "type": "string"
          },
          "group": {
            "description": "Group shown together in the viewer.",
            "type": "string"
          },
          "id": {
            "description": "Id of the segment: lowercase ASCII letters, digits and dashes.",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$",
            "type": "string"
          },
          "name": {
            "description": "Display name.",
            "type": "string"
          },
          "text": {
            "description": "Notes for organizers.",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ],
        "type": "object"
      },
      "type": "array"
    }
  },
  "required": [],
  "title": "segments.toml",
  "type": "object"
}
